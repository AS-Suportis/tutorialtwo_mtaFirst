{
  "name": "tutorialtwo",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-tutelem": "cds watch --open tutelem/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy tutorialtwo --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-tutui5": "cds watch --open tutui5/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-tutadmin": "cds watch --open tutadmin/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana"
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": { 
              "password": "admin",
              "roles":  [
                  "admin", "user"
                ]
            },
            "user": {
              "password": "user",
              "roles":  [
                  "user"
                ]
              }
            }
          },
      "[production]": {
          "kind": "xsuaa"
        }
    },
      "html5-repo": true,
      "destinations": true,
      "workzone": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/tutelem",
    "app/tutadmin"
  ]
}
